# AssemblyAI server-side credential.
# Copy this file to .env and replace the placeholder locally.
# Never commit the real API key.
ASSEMBLYAI_API_KEY=replace-with-your-assemblyai-api-key

# Voice Authority local application runtime.
# Keep the backend loopback-only; external exposure belongs at a separate boundary.
VOICE_AUTHORITY_HOST=127.0.0.1
VOICE_AUTHORITY_PORT=8003
